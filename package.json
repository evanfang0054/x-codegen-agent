{
  "name": "x-codegen-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "X-CodeGen-Agent Monorepo - 基于 LangChain 的前端代码生成工具集",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo run test",
    "check": "turbo check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "langchain",
    "agent",
    "ai",
    "codegen",
    "monorepo"
  ],
  "author": "evanfang",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@changesets/cli": "^2.28.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.15.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
