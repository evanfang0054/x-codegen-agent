{
  "name": "@x-codegen/cli",
  "version": "1.0.0",
  "description": "X-CodeGen CLI - 前端代码生成命令行工具",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "x-codegen": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "codegen",
    "langchain",
    "ai"
  ],
  "author": "evanfang",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.1.24",
    "@x-codegen/sdk": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^17.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
