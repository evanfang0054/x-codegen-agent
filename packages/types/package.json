{
  "name": "@x-codegen/types",
  "version": "1.0.0",
  "description": "X-CodeGen 共享类型定义",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["types", "codegen", "langchain"],
  "author": "evanfang",
  "license": "MIT",
  "devDependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "1.1.4",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.1.0"
  }
}
